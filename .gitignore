# Runtime and research data stay on this machine: candles, research outputs,
# NSE filings, paper-trading state, logs and captures are large, regenerable
# or private. Tracked exceptions are what the live paper run needs to start.
logs/
data/*
!data/models/
data/models/*
!data/models/scanner_up1_by_close_v1/
!data/models/scanner_move10_by_close_v1/
!data/universe_mcap_20261012/
!data/universe_nifty500_20261012/
*.log
*.db
*.sqlite
*.sqlite3

# Machine-local tooling that is not part of this project
Programs/

# Probe output. Live-run artefacts are evidence for a session, not for the
# repository: what matters from them is written up in docs/LIVE_API_SAMPLES.md,
# and the raw JSON/CSV would otherwise accumulate a file per market day.
.scratch/

# Where ai_trader.cli.backtest appends when --history is not given. A row is
# published by pointing --history at backtests/, so anything landing here is an
# exploratory run that happened to be launched without one.
/backtest_history.tsv
