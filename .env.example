# Never place real credentials in this file.
# Copy this file to .env and populate locally.

# Zerodha Kite Connect app: market data and the daily browser login (required).
KITE_API_KEY=
KITE_API_SECRET=

# OpenAI: the main AI and gpt-* shadows (required).
OPENAI_API_KEY=
# Optional main AI and effort; empty means gpt-6-luna, low.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_SECONDS=

# Anthropic: only for claude-* shadows (e.g. --shadow claude-sonnet-5-5:low).
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_SECONDS=

# Spend cap per AI per IST day, in USD; empty means 5.
AI_DAILY_BUDGET_USD=

# Used only by scripts/sync.sh to push and pull over HTTPS.
GITHUB_PAT=
GITHUB_USERNAME=
